# Open Model Lab: reproducible code is tracked; large local runtimes and weights are not.
model_lab/micro_sam/.venv-micro-sam/
model_lab/micro_sam/cache/
model_lab/micro_sam/wheels/
model_lab/micro_sam/weights/
model_lab/micro_sam/environment_status.json
