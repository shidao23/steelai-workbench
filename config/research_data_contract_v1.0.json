  },
  "relationships": [
    {"from": "composition.sample_id", "to": "samples.sample_id", "cardinality": "one_to_one"},
    {"from": "composition_observations.sample_id", "to": "samples.sample_id", "cardinality": "one_to_many"},
    {"from": "process.sample_id", "to": "samples.sample_id", "cardinality": "one_to_one"},
    {"from": "microstructure.sample_id", "to": "samples.sample_id", "cardinality": "one_to_one_summary"},
    {"from": "properties.sample_id", "to": "samples.sample_id", "cardinality": "one_to_one_summary"},
    {"from": "process_steps.sample_id", "to": "samples.sample_id", "cardinality": "one_to_many"},
    {"from": "microstructure_observations.sample_id", "to": "samples.sample_id", "cardinality": "one_to_many"},
    {"from": "property_observations.sample_id", "to": "samples.sample_id", "cardinality": "one_to_many"},
    {"from": "physics_observations.sample_id", "to": "samples.sample_id", "cardinality": "one_to_many"},
    {"from": "thermal_simulation_runs.sample_id", "to": "samples.sample_id", "cardinality": "one_to_many"},
    {"from": "thermal_simulation_points.sample_id", "to": "samples.sample_id", "cardinality": "one_to_many"},
    {"from": "thermal_simulation_points.experiment_run_id", "to": "thermal_simulation_runs.experiment_run_id", "cardinality": "many_to_one"},
    {"from": "thermal_simulation_features.experiment_run_id", "to": "thermal_simulation_runs.experiment_run_id", "cardinality": "one_to_one_per_feature_version"}
    ,{"from": "thermal_simulation_softening.experiment_run_id", "to": "thermal_simulation_features.experiment_run_id", "cardinality": "one_to_one_per_softening_version"}
  ],
  "physics_model_requirements": [
    "model_id",
    "model_version",
    "model_family",
    "formula_or_backend",
    "source",
    "required_inputs",
    "output_unit",
    "applicability",
    "applicable_composition_range",
    "limitations",
    "license",
    "review_status",
    "experimental_reference",
    "residual",
    "calibration_status"
  ],
  "future_model_families": [
    "empirical_formula",
    "thermodynamic_equilibrium",
    "kinetic_transformation",
    "experiment_calibrated_model",
    "machine_learning_surrogate"
  ]
}
