        "softening_values_outside_0_to_1_are_flagged_and_never_clamped",
        "five_percent_sigma_m_is_a_declared_hollomon_projection_not_an_observed_point",
        "formal_results_require_named_review_of_exact_candidate_values",
        "source_feature_and_method_registry_hashes_are_required"
