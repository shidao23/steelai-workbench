{
  "contract_id": "SteelAI-ResearchData-BR-v1.1",
  "schema_version": "1.1",
  "scope": {
    "included_samples": ["B-DQ", "R-DQ"],
    "excluded_datasets": ["experiments_1_14"],
    "source_of_truth": "external_raw_experiment_folders_read_only",
    "missing_value_rule": "blank_is_missing_not_zero"
  },
  "tables": {
    "samples": {
      "path": "data/processed/samples.csv",
      "required": true,
      "essential_fields": ["sample_id", "steel", "condition", "batch", "data_status"],
      "recommended_fields": ["notes"],
      "units": {}
    },
    "composition": {
      "path": "data/processed/composition.csv",
      "required": true,
      "essential_fields": ["sample_id", "C", "Mn", "Si", "source_status"],
      "recommended_fields": ["Cr", "Ni", "Mo", "Nb", "V", "Ti", "Al", "Cu", "P", "S", "N", "B", "As", "Sn", "Sb"],
      "optional_fields": ["O", "W"],
      "numeric_fields": ["C", "Mn", "Si", "Cr", "Ni", "Mo", "Nb", "V", "Ti", "Al", "Cu", "P", "S", "N", "B", "As", "Sn", "Sb", "O", "W"],
      "units": {"default_numeric": "wt.%"}
    },
    "composition_observations": {
      "path": "data/processed/composition_observations.csv",
      "required": false,
      "essential_fields": ["sample_id", "observation_id", "element", "value", "unit", "source_status"],
      "recommended_fields": ["heat_id", "method", "uncertainty", "replicate_group"],
      "optional_fields": ["notes"],
      "numeric_fields": ["value", "uncertainty"],
      "allowed_units": ["wt.%", "mass_ppm"],
      "primary_key": ["observation_id"],
      "interpretation_guardrails": [
        "blank_is_missing_not_zero",
        "repeated_readings_are_not_automatically_independent_heats"
      ]
    },
    "process": {
      "path": "data/processed/process.csv",
      "required": true,
      "essential_fields": ["sample_id", "rolling_passes", "cooling_route", "source_status"],
      "recommended_fields": ["reheat_temp_c", "roughing_temp_c", "finish_temp_c", "total_reduction_pct", "quench_medium", "tempering_temp_c", "tempering_time_min"],
      "numeric_fields": ["rolling_passes", "reheat_temp_c", "roughing_temp_c", "finish_temp_c", "total_reduction_pct", "tempering_temp_c", "tempering_time_min"],
      "units": {"temperature": "degC", "time": "min", "reduction": "%"}
    },
    "microstructure": {
      "path": "data/processed/microstructure.csv",
      "required": true,
      "essential_fields": ["sample_id"],
      "recommended_fields": ["pag_size_um", "packet_size_um", "block_size_um", "hagb_pct", "kam_mean_deg", "gnd_m2"],
      "optional_fields": ["manual_notes"],
      "numeric_fields": ["pag_size_um", "packet_size_um", "block_size_um", "hagb_pct", "kam_mean_deg", "gnd_m2"],
      "units": {"size": "um", "boundary_fraction": "%", "kam": "deg", "gnd": "m^-2"},
      "interpretation_guardrails": [
        "multiple_fields_from_one_specimen_are_not_independent_specimen_replicates",
        "ebsd_scales_must_not_be_pooled",
        "orientation_grains_are_not_automatically_packets_blocks_or_prior_austenite_grains"
      ]
    },
    "properties": {
      "path": "data/processed/properties.csv",
      "required": true,
      "essential_fields": ["sample_id", "ys_mpa", "uts_mpa", "impact_minus40_j", "replicates", "source_status"],
      "recommended_fields": ["ys_std_mpa", "uts_std_mpa", "elongation_pct", "reduction_area_pct", "impact_std_j", "impact_toughness_j_cm2", "hv"],
      "numeric_fields": ["ys_mpa", "ys_std_mpa", "uts_mpa", "uts_std_mpa", "elongation_pct", "elongation_std_pct", "reduction_area_pct", "reduction_area_std_pct", "impact_minus40_j", "impact_std_j", "impact_toughness_j_cm2", "hv", "replicates"],
      "units": {"strength": "MPa", "impact_energy": "J", "impact_toughness": "J/cm^2", "hardness": "HV"},
      "interpretation_guardrails": [
        "aggregate_replicate_count_does_not_prove_independent_specimens",
        "statistical_significance_requires_specimen_level_records"
      ]
    },
    "process_steps": {
      "path": "data/processed/process_steps.csv",
      "required": false,
      "essential_fields": ["sample_id", "step_id", "step_type", "sequence", "source_status"],
      "recommended_fields": ["start_temp_c", "end_temp_c", "strain", "strain_rate_s", "duration_s", "cooling_rate_c_s"],
      "numeric_fields": ["sequence", "start_temp_c", "end_temp_c", "strain", "strain_rate_s", "duration_s", "cooling_rate_c_s"],
      "optional_fields": ["notes"],
      "primary_key": ["sample_id", "step_id"],
      "interpretation_guardrails": ["step_sequence_must_preserve_the_real_process_order"]
    },
    "microstructure_observations": {
      "path": "data/processed/microstructure_observations.csv",
      "required": false,
      "essential_fields": ["sample_id", "observation_id", "method", "field_id", "metric", "value", "unit", "source_status"],
      "recommended_fields": ["acquisition_group", "magnification", "step_size_um", "roi_definition", "uncertainty"],
      "numeric_fields": ["value", "magnification", "step_size_um", "uncertainty"],
      "optional_fields": ["specimen_id", "notes"],
      "allowed_units": ["um", "%", "deg", "m^-2", "count", "dimensionless", "px"],
      "primary_key": ["observation_id"],
      "interpretation_guardrails": [
        "fields_are_nested_within_specimens",
        "different_acquisition_scales_remain_separate"
      ]
    },
    "property_observations": {
      "path": "data/processed/property_observations.csv",
      "required": false,
      "essential_fields": ["sample_id", "specimen_id", "property", "value", "unit", "source_status"],
      "recommended_fields": ["test_temperature_c", "orientation", "standard", "replicate_group"],
      "numeric_fields": ["value", "test_temperature_c"],
      "optional_fields": ["uncertainty", "notes"],
      "allowed_units": ["MPa", "%", "J", "J/cm^2", "HV"],
      "primary_key": ["sample_id", "specimen_id", "property"],
      "interpretation_guardrails": ["specimen_id_is_required_for_inferential_statistics"]
    },
    "physics_observations": {
      "path": "data/processed/physics_observations.csv",
      "required": false,
      "essential_fields": ["sample_id", "observation_id", "quantity", "value", "unit", "measurement_type", "source_status"],
      "recommended_fields": ["method", "uncertainty", "replicates", "model_id", "model_value", "residual"],
      "numeric_fields": ["value", "uncertainty", "replicates", "model_value", "residual"],
      "optional_fields": ["specimen_id", "run_id", "notes"],
      "primary_key": ["observation_id"],
      "allowed_measurement_types": ["experimental", "model_estimate", "calibrated_estimate"],
      "interpretation_guardrails": [
        "model_estimate_is_not_experimental_truth",
        "residual_requires_matched_experimental_and_model_values"
      ]
    },
    "thermal_simulation_runs": {
      "path": "data/processed/thermal_simulation_runs.csv",
      "required": false,
      "essential_fields": ["sample_id", "specimen_id", "experiment_run_id", "program", "acquisition_id", "source_status", "review_status"],
      "recommended_fields": ["test_type", "planned_temperature_c", "planned_interpass_time_s", "strain_1", "strain_2", "strain_rate_s", "specimen_diameter_mm", "specimen_height_mm", "interval_count", "point_count", "period_value_raw", "sampling_period_s", "measured_interval_gap_raw", "measured_interval_gap_s", "measured_reference_temperature_c", "temperature_measurement_metric", "effective_temperature_c", "effective_interpass_time_s", "time_unit_interpretation", "force_unit_interpretation", "force_time_offset_raw", "stroke_time_offset_raw", "temperature_time_offset_raw", "source_file_sha256", "plan_source_status"],
      "optional_fields": ["notes"],
      "numeric_fields": ["planned_temperature_c", "planned_interpass_time_s", "strain_1", "strain_2", "strain_rate_s", "specimen_diameter_mm", "specimen_height_mm", "interval_count", "point_count", "period_value_raw", "sampling_period_s", "measured_interval_gap_raw", "measured_interval_gap_s", "measured_reference_temperature_c", "effective_temperature_c", "effective_interpass_time_s", "force_time_offset_raw", "stroke_time_offset_raw", "temperature_time_offset_raw"],
      "primary_key": ["experiment_run_id"],
      "interpretation_guardrails": [
        "planned_parameters_are_not_measured_values",
        "conflicting_plan_values_may_be_retained_but_must_not_replace_reviewed_instrument_values",
        "acquisition_id_does_not_prove_physical_specimen_identity_without_review",
        "instrument_force_unit_Kg_must_not_be_converted_without_an_explicit_unit_basis"
      ]
    },
    "thermal_simulation_points": {
      "path": "data/processed/thermal_simulation_points.csv",
      "required": false,
      "essential_fields": ["sample_id", "specimen_id", "experiment_run_id", "interval_index", "point_index", "time_value_raw", "time_s", "force_value_raw", "force_unit_raw", "stroke_value_raw", "stroke_unit_raw", "stroke_mm", "control_temperature_raw", "control_temperature_unit_raw", "control_temperature_c", "source_status"],
      "recommended_fields": [],
      "optional_fields": ["force_n"],
      "numeric_fields": ["interval_index", "point_index", "time_value_raw", "time_s", "force_value_raw", "force_n", "stroke_value_raw", "stroke_mm", "control_temperature_raw", "control_temperature_c"],
      "primary_key": ["experiment_run_id", "interval_index", "point_index"],
      "interpretation_guardrails": [
        "blank_force_n_is_missing_not_zero",
        "source_force_sign_is_preserved",
        "stress_strain_curves_require_a_separately_reviewed_geometry_and_area_convention"
      ]
    },
    "thermal_simulation_features": {
      "path": "data/processed/thermal_simulation_features.csv",
      "required": false,
      "essential_fields": ["sample_id", "specimen_id", "experiment_run_id", "acquisition_id", "feature_version", "test_type", "formula_id", "segment_policy_id", "segment_review_status", "segment_reviewer_id", "segment_reviewed_at", "source_status", "source_file_sha256", "source_points_sha256", "formula_config_sha256", "segment_policy_sha256", "feature_policy_sha256", "segment_candidate_sha256", "feature_row_sha256"],
      "recommended_fields": ["effective_temperature_c", "run_effective_interpass_time_s", "effective_deformation_gap_s", "hit1_start_point_index", "hit1_end_point_index", "hit1_start_time_s", "hit1_end_time_s", "hit1_start_temperature_c", "hit1_mean_temperature_c", "hit1_end_temperature_c", "hit1_peak_stress_mpa", "hit1_peak_local_true_strain", "hit1_peak_temperature_c", "hit1_max_stroke_cm", "hit1_max_displacement_from_contact_cm", "hit1_max_local_true_strain", "hit1_flow_stress_at_strain_0p05_mpa", "hit1_flow_stress_at_strain_0p1_mpa", "hit1_flow_stress_at_strain_0p15_mpa", "hit1_flow_stress_at_strain_0p2_mpa", "hit2_start_point_index", "hit2_end_point_index", "hit2_start_time_s", "hit2_end_time_s", "hit2_start_temperature_c", "hit2_mean_temperature_c", "hit2_end_temperature_c", "hit2_peak_stress_mpa", "hit2_peak_local_true_strain", "hit2_peak_temperature_c", "hit2_max_stroke_cm", "hit2_max_displacement_from_contact_cm", "hit2_max_local_true_strain", "hit2_flow_stress_at_strain_0p05_mpa", "hit2_flow_stress_at_strain_0p1_mpa", "hit2_flow_stress_at_strain_0p15_mpa", "hit2_flow_stress_at_strain_0p2_mpa"],
      "optional_fields": ["source_run_review_status"],
      "numeric_fields": ["acquisition_id", "effective_temperature_c", "run_effective_interpass_time_s", "effective_deformation_gap_s", "hit1_start_point_index", "hit1_end_point_index", "hit1_start_time_s", "hit1_end_time_s", "hit1_start_temperature_c", "hit1_mean_temperature_c", "hit1_end_temperature_c", "hit1_peak_stress_mpa", "hit1_peak_local_true_strain", "hit1_peak_temperature_c", "hit1_max_stroke_cm", "hit1_max_displacement_from_contact_cm", "hit1_max_local_true_strain", "hit1_flow_stress_at_strain_0p05_mpa", "hit1_flow_stress_at_strain_0p1_mpa", "hit1_flow_stress_at_strain_0p15_mpa", "hit1_flow_stress_at_strain_0p2_mpa", "hit2_start_point_index", "hit2_end_point_index", "hit2_start_time_s", "hit2_end_time_s", "hit2_start_temperature_c", "hit2_mean_temperature_c", "hit2_end_temperature_c", "hit2_peak_stress_mpa", "hit2_peak_local_true_strain", "hit2_peak_temperature_c", "hit2_max_stroke_cm", "hit2_max_displacement_from_contact_cm", "hit2_max_local_true_strain", "hit2_flow_stress_at_strain_0p05_mpa", "hit2_flow_stress_at_strain_0p1_mpa", "hit2_flow_stress_at_strain_0p15_mpa", "hit2_flow_stress_at_strain_0p2_mpa"],
      "primary_key": ["experiment_run_id", "feature_version"],
      "interpretation_guardrails": [
        "features_require_named_human_approval_of_effective_loading_segments",
        "target_strain_flow_stress_must_not_be_extrapolated",
        "feature_values_are_deterministic_derivations_not_raw_measurements",
        "formula_segment_source_and_feature_hashes_are_required"
      ]
    },
    "thermal_simulation_softening": {
      "path": "data/processed/thermal_simulation_softening.csv",
      "required": false,
      "essential_fields": ["sample_id", "specimen_id", "experiment_run_id", "acquisition_id", "softening_version", "feature_version", "test_type", "method_registry_id", "method_registry_sha256", "primary_method_id", "sensitivity_method_id", "method_selection_status", "method_decision_reviewer_id", "method_decided_at", "result_review_status", "result_reviewer_id", "result_reviewed_at", "source_status", "source_feature_review_status", "source_feature_reviewer_id", "source_feature_row_sha256", "primary_result_status", "sensitivity_result_status", "result_qc_status", "softening_row_sha256"],
      "recommended_fields": ["effective_temperature_c", "run_effective_interpass_time_s", "effective_deformation_gap_s", "primary_sigma_m_mpa", "primary_sigma_1_mpa", "primary_sigma_2_mpa", "primary_softening_fraction_raw", "primary_softening_percent_raw", "hit1_offset_proof_true_strain", "hit1_offset_fit_point_count", "hit1_offset_fit_slope_mpa", "hit1_offset_fit_intercept_mpa", "hit1_offset_fit_r_squared", "hit1_offset_fit_strain_min", "hit1_offset_fit_strain_max", "hit2_offset_proof_true_strain", "hit2_offset_fit_point_count", "hit2_offset_fit_slope_mpa", "hit2_offset_fit_intercept_mpa", "hit2_offset_fit_r_squared", "hit2_offset_fit_strain_min", "hit2_offset_fit_strain_max", "sensitivity_sigma_m_mpa", "sensitivity_sigma_1_mpa", "sensitivity_sigma_2_mpa", "sensitivity_softening_fraction_raw", "sensitivity_softening_percent_raw", "sensitivity_evaluation_true_strain", "hollomon_fit_point_count", "hollomon_fit_r_squared", "hollomon_fit_strain_min", "hollomon_fit_strain_max", "hollomon_strength_coefficient_k_mpa", "hollomon_strain_hardening_exponent_n", "hollomon_projection_true_strain", "sensitivity_minus_primary_fraction", "qc_flags"],
      "optional_fields": [],
      "numeric_fields": ["acquisition_id", "effective_temperature_c", "run_effective_interpass_time_s", "effective_deformation_gap_s", "primary_sigma_m_mpa", "primary_sigma_1_mpa", "primary_sigma_2_mpa", "primary_softening_fraction_raw", "primary_softening_percent_raw", "hit1_offset_proof_true_strain", "hit1_offset_fit_point_count", "hit1_offset_fit_slope_mpa", "hit1_offset_fit_intercept_mpa", "hit1_offset_fit_r_squared", "hit1_offset_fit_strain_min", "hit1_offset_fit_strain_max", "hit2_offset_proof_true_strain", "hit2_offset_fit_point_count", "hit2_offset_fit_slope_mpa", "hit2_offset_fit_intercept_mpa", "hit2_offset_fit_r_squared", "hit2_offset_fit_strain_min", "hit2_offset_fit_strain_max", "sensitivity_sigma_m_mpa", "sensitivity_sigma_1_mpa", "sensitivity_sigma_2_mpa", "sensitivity_softening_fraction_raw", "sensitivity_softening_percent_raw", "sensitivity_evaluation_true_strain", "hollomon_fit_point_count", "hollomon_fit_r_squared", "hollomon_fit_strain_min", "hollomon_fit_strain_max", "hollomon_strength_coefficient_k_mpa", "hollomon_strain_hardening_exponent_n", "hollomon_projection_true_strain", "sensitivity_minus_primary_fraction"],
      "primary_key": ["experiment_run_id", "softening_version"],
      "interpretation_guardrails": [
