      "sigma_m_definition": "flow_stress_at_end_of_first_hit",
      "interpretation": "mechanical_total_softening_recovery_plus_recrystallization",
      "current_batch_note": "offset_is_smaller_than_one_observed_strain_increment"
    },
    {
      "method_id": "offset_2p0_srx_focused",
      "label": "2% 偏移法",
      "offset_true_strain": 0.02,
      "sigma_m_definition": "maximum_flow_stress_of_first_hit",
      "interpretation": "static_recrystallization_focused_mechanical_estimate",
      "current_batch_note": "offset_spans_about_five_median_observed_strain_increments",
      "yield_extraction": {
        "curve_preparation": "median_stress_for_equal_local_strain_then_sort_ascending",
        "initial_linear_fit_min_true_strain_exclusive": 0.0,
        "initial_linear_fit_max_true_strain_inclusive": 0.02,
        "minimum_unique_fit_points": 4,
        "minimum_fit_r_squared": 0.75,
        "intersection_rule": "first_curve_offset_line_crossing_at_or_after_offset_linear_interpolation",
        "extrapolation": "forbidden"
      }
    },
    {
      "method_id": "fixed_true_strain_0p05",
      "label": "5% 定真应变法",
      "offset_true_strain": null,
      "evaluation_true_strain": 0.05,
      "sigma_m_definition": "first_hit_reference_stress_defined_by_method",
      "interpretation": "fixed_strain_mechanical_softening",
      "current_batch_note": "sigma_1_and_sigma_2_are_supported_by_T74; sigma_m_uses_declared_hollomon_projection",
