        "evaluation_true_strain": 0.05,
        "sigma_1_definition": "first_hit_flow_stress_at_local_true_strain_0p05",
        "sigma_2_definition": "second_hit_flow_stress_at_local_true_strain_0p05",
        "sigma_m_definition": "hollomon_first_hit_projection_at_first_hit_max_local_true_strain_plus_0p05",
        "hollomon_equation": "sigma=K*epsilon^n",
        "hollomon_fit_min_true_strain_inclusive": 0.05,
        "hollomon_fit_max_true_strain": "first_hit_observed_maximum",
        "minimum_unique_fit_points": 10,
        "minimum_fit_r_squared": 0.9,
        "projection_increment_true_strain": 0.05
      }
    },
    {
      "method_id": "mean_flow_stress",
      "label": "平均流动应力法",
